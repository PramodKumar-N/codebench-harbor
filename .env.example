# Copy this file to `.env` (or `.env.local`) and fill in ONLY the key(s) for the provider you use.
# Both `.env` and `.env.*` (except `.env.example`) are ignored by Git.
# Never commit real API keys.
#
# When running Harbor, load `.env` explicitly with:
#   .\.venv\Scripts\harbor.exe run --config benchmark.yaml --env-file .env
# (Harbor also auto-loads `.env.local` if present in the working directory.)

# --- OpenAI (e.g., openai/gpt-4o-mini, openai/gpt-4.1-mini, openai/gpt-4o) ---
OPENAI_API_KEY=

# --- Anthropic (e.g., anthropic/claude-haiku-4-5, anthropic/claude-sonnet-4-6) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (e.g., gemini/gemini-2.5-flash, gemini/gemini-2.5-pro) ---
GEMINI_API_KEY=

# --- Optional: OpenRouter / DeepSeek / Custom OpenAI-compatible ---
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_BASE_URL=
